VITE_MASTERDATABASE_MEASUREMENT_ID=
VITE_MASTERDATABASE_COLLECTION=/CMG-HR-Database/root/employee_data
VITE_MASTERDATABASE_EMPLOYEE_CODE_FIELD=employeeCode
